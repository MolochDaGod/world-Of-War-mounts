{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack enable && COREPACK_ENABLE_DOWNLOAD_PROMPT=0 COREPACK_ENABLE_STRICT=0 pnpm install --no-frozen-lockfile",
  "buildCommand": "COREPACK_ENABLE_STRICT=0 pnpm --filter @workspace/toon-rts build",
  "outputDirectory": "artifacts/toon-rts/dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
